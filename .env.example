# По умолчанию приложение продолжает использовать JSON.
DATA_BACKEND=json

# Обязательный секрет подписи сессий для production: не менее 32 случайных символов.
AUTH_SECRET=

# Начальный администратор создаётся только если хранилище пользователей пустое.
# Задайте собственные логин и пароль (не менее 8 символов) перед первым запуском.
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=

# Публичный адрес приложения используется для проверки Origin у изменяющих запросов.
APP_ORIGIN=http://127.0.0.1:3000

# Серверный ключ AI-провайдера. Ключу нужны права на prompt, загрузку файлов и Vector Store.
# Переменные с префиксом NEXT_PUBLIC_ для ключей запрещены.
AI_API_KEY=
AI_PROJECT_ID=
AI_PROMPT_ID=
AI_VECTOR_STORE_ID=
AI_ENABLE_WEB_SEARCH=false

# OCR для фотографий и PDF-сканов. На Linux нужны tesseract-ocr и poppler-utils.
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_MAX_PDF_PAGES=60
OCR_COMMAND_TIMEOUT_MS=120000

# Уведомления сохраняются только в личном кабинете; внешние каналы не настраиваются.

# Для MySQL установите DATA_BACKEND=mysql и заполните значения ниже.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vates
MYSQL_USER=vates_app
MYSQL_PASSWORD=change_me
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Вместо отдельных MYSQL_* можно использовать одну строку:
# MYSQL_URL=mysql://vates_app:change_me@127.0.0.1:3306/vates
